# ═══════════════════════════════════════════════════════
# NB LAO — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────
# Server port (default: 3001)
PORT=3001

# Environment: development | test | production
NODE_ENV=development

# ── Database (Prisma) ─────────────────────────────────
# Required. SQLite: use file path; PostgreSQL: full connection string.
# Examples:
#   SQLite:    DATABASE_URL="file:./dev.db"
#   PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/nblao"
DATABASE_URL="file:./dev.db"

# ── Authentication ─────────────────────────────────────
# REQUIRED in production. Minimum 32 characters recommended.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# Token expiry (default: 7d)
# JWT_EXPIRES="7d"

# ── Application URL ────────────────────────────────────
# Used for password reset links and email templates.
# Example: https://nblao.la
# Defaults to http://localhost:PORT if not set.
APP_URL=""

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# If empty, all origins are allowed (dev mode).
# Example: https://nblao.la,https://admin.nblao.la
CORS_ORIGINS=""

# ── Email / SMTP ───────────────────────────────────────
# If SMTP_HOST is empty, emails are logged to console (dev mode).
# In production, SMTP_HOST, SMTP_USER, and SMTP_PASSWORD are required.
# Supported ports: 587 (STARTTLS) or 465 (SSL/TLS).
# The application validates SMTP config on startup and warns if incomplete.
# Never commit real SMTP credentials to version control.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@nblao.la"
SMTP_FROM_NAME="NB LAO"
